{
  "name": "seatsignal-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SeatSignal AWS Lambda functions (scheduled checks, contract extraction, usage import).",
  "engines": { "node": ">=20" },
  "scripts": {
    "sync-engine": "cp ../web/js/engine.js shared/engine.cjs",
    "prebuild": "npm run sync-engine",
    "build": "sam build --template template.yaml",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.35.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "pg": "^8.13.0"
  }
}
